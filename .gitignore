/data/db/*.sqlite3
/data/db/*.sqlite3-*
/data/news_claw.db
/playground/
/data/knowledge/**/summaries/
/data/raw/
/data/normalized/
/data/runs/
/data/db/*.lock
/bin/
/coverage.out

