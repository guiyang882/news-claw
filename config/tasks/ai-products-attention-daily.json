{
  "id": "ai-products-attention-daily",
  "name": "海外 AI 产品关注度与用户反馈",
  "description": "追踪海外用户对 Muse、Gemini Agent、GPT/ChatGPT 等产品的关注变化、实际体验和反馈。",
  "scheduler_engine": "news-claw",
  "enabled": true,
  "schedule": "45 10,18 * * *",
  "timezone": "Asia/Shanghai",
  "topic_ids": [
    "ai-products-attention-feedback"
  ],
  "collector": {
    "type": "multi_source_news_and_public_discussion",
    "languages": [
      "en"
    ],
    "request_policy": {
      "max_concurrent_requests_per_host": 1,
      "min_interval_seconds_per_host": 10,
      "google_search_min_interval_seconds": 60,
      "honor_retry_after": true,
      "retry_backoff_seconds": [
        60,
        300,
        900
      ],
      "max_requests_per_run": 12,
      "stop_on_403_429_or_access_denial": true,
      "automatic_retry_after_denial": false,
      "shared_circuit_paths": [
        "/mnt/quant-state/quant-web/news_circuit.json"
      ],
      "min_interval_seconds_global": 10
    },
    "source_classes": [
      "official_product_announcements",
      "reputable_technology_news",
      "public_forums_and_communities",
      "public_product_reviews_and_benchmarks"
    ],
    "product_watchlist": [
      "Muse",
      "Gemini Agent",
      "GPT",
      "ChatGPT"
    ],
    "disambiguation": "Muse is ambiguous; include a result only when context supports that it refers to an AI product, model, or agent, and record the identified product/vendor when possible.",
    "sources": [
      {
        "name": "muse-ai",
        "type": "rss",
        "url": "https://news.google.com/rss/search?q=%22Muse%22+AI+%28product+OR+agent%29+when%3A1d&hl=en-US&gl=US&ceid=US%3Aen",
        "language": "en",
        "source_class": "public_news_discovery",
        "obey_robots_txt": false
      },
      {
        "name": "gemini-agent",
        "type": "rss",
        "url": "https://news.google.com/rss/search?q=%22Gemini%22+agent+%28review+OR+feedback+OR+users%29+when%3A1d&hl=en-US&gl=US&ceid=US%3Aen",
        "language": "en",
        "source_class": "public_news_discovery",
        "obey_robots_txt": false
      },
      {
        "name": "gpt-feedback",
        "type": "rss",
        "url": "https://news.google.com/rss/search?q=%28ChatGPT+OR+GPT%29+%28review+OR+feedback+OR+users%29+when%3A1d&hl=en-US&gl=US&ceid=US%3Aen",
        "language": "en",
        "source_class": "public_news_discovery",
        "obey_robots_txt": false
      },
      {
        "name": "google-ai-announcements",
        "type": "rss",
        "url": "https://blog.google/technology/ai/rss/",
        "language": "en",
        "source_class": "official_product_announcements"
      },
      {
        "name": "openai-announcements",
        "type": "rss",
        "url": "https://openai.com/news/rss.xml",
        "language": "en",
        "source_class": "official_product_announcements"
      },
      {
        "name": "hacker-news-ai-discussion",
        "type": "rss",
        "url": "https://news.ycombinator.com/rss",
        "language": "en",
        "source_class": "public_forums_and_communities",
        "include_keywords": [
          "muse",
          "gemini",
          "gpt",
          "chatgpt",
          "openai",
          "agent",
          "agents",
          "llm"
        ]
      }
    ],
    "robots_override": {
      "scope": "explicit_google_news_rss_urls_only",
      "requested_by": "user",
      "reason": "User explicitly requested Google News RSS restoration and ignoring robots for these feeds.",
      "requested_at": "2026-10-11",
      "http_denial_and_rate_limit_circuits_retained": true
    }
  },
  "options": {
    "start_jitter_seconds": 300,
    "lookback_hours": 72,
    "max_items_per_run": 200,
    "measure": [
      "discussion_volume_and_change",
      "engagement_signals_when_available",
      "user_sentiment_with_evidence",
      "reported_use_cases_and_outcomes",
      "recurring_strengths_and_pain_points",
      "product_comparisons_and_switching"
    ],
    "separate_anecdotes_from_representative_metrics": true,
    "output_artifact_types": [
      "timeline",
      "logic",
      "inferences",
      "relations",
      "summaries"
    ],
    "collection_stage": "news_discovery_only"
  },
  "schedule_format": "cron",
  "execution": {
    "command": [
      ".venv/bin/python",
      "-m",
      "collectors.news"
    ],
    "working_dir": ".",
    "timeout_seconds": 1800,
    "lock_group": "web-fetch"
  },
  "task_type": "crawl",
  "workflow": {
    "website_repo": "/mnt/quant/strategies/stocks-quant",
    "stage": "news_discovery",
    "outputs": [
      "data/raw",
      "data/normalized",
      "documents"
    ],
    "publication_status": "feeds_daily_blog_workflow_not_direct_webpage_publication",
    "website_runtime": {
      "stack": "nginx-nextjs-python",
      "proxy": "nginx",
      "frontend_service": "quant-next-web.service",
      "content_service": "quant-web.service",
      "proxy_service": "nginx.service",
      "content_update_action": "none",
      "content_reload_command": [
        "systemctl",
        "kill",
        "--kill-whom=main",
        "--signal=HUP",
        "quant-web.service"
      ],
      "frontend_restart_command": [
        "systemctl",
        "restart",
        "quant-next-web.service"
      ],
      "proxy_validate_command": [
        "/usr/sbin/nginx",
        "-t"
      ],
      "proxy_reload_command": [
        "systemctl",
        "reload",
        "nginx.service"
      ],
      "frontend_deployment": {
        "source_dir": "/mnt/quant/strategies/stocks-quant/web/frontend",
        "runbook": "/mnt/quant/strategies/stocks-quant/deployment/NEXTJS.md",
        "policy": "candidate_build_smoke_atomic_switch",
        "build_in_running_directory": false,
        "retain_previous_static_chunks": true,
        "steps": [
          "build_and_typecheck_in_separate_candidate_directory",
          "smoke_test_candidate",
          "retain_previous_static_chunks",
          "stop_frontend",
          "atomically_install_candidate_next_artifacts",
          "verify_service_user_file_permissions",
          "start_frontend",
          "verify_local_and_https_pages"
        ],
        "runtime_content_requires_frontend_build": false,
        "shared_credentials": "controlled_environment_only_not_task_json_or_logs",
        "candidate_build": {
          "working_dir": "<separate_candidate_repo_root>",
          "command": [
            "make",
            "test-frontend",
            "build-frontend"
          ]
        },
        "candidate_smoke": {
          "working_dir": "/mnt/quant/strategies/stocks-quant",
          "command": [
            "/mnt/quant/strategies/stocks-quant/web/.venv/bin/python",
            "web/frontend/scripts/smoke.py",
            "--frontend-dir",
            "<candidate_frontend_dir>"
          ]
        }
      },
      "health": {
        "host": "growthyoung.com",
        "content_port": 8000,
        "frontend_port": 3000,
        "https_port": 443,
        "content_path": "/healthz",
        "frontend_path": "/blog",
        "frontend_body_marker": "RESEARCH LIBRARY",
        "timeout_seconds": 10
      },
      "command_timeout_seconds": 30,
      "readiness_wait_seconds": 30
    },
    "website_delivery": {
      "kind": "local_evidence",
      "reader": "daily-blog source packet; no direct website publication",
      "after_publish": "none",
      "frontend_build_required": false,
      "restart_required": false
    }
  }
}
