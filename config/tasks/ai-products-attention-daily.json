{
  "id": "ai-products-attention-daily",
  "name": "海外 AI 产品关注度与用户反馈",
  "description": "追踪海外用户对 Muse、Gemini Agent、GPT/ChatGPT 等产品的关注变化、实际体验和反馈。",
  "scheduler_engine": "news-claw",
  "enabled": true,
  "schedule": "45 10,18 * * *",
  "timezone": "Asia/Shanghai",
  "topic_ids": [
    "ai-products-attention-feedback"
  ],
  "collector": {
    "type": "multi_source_news_and_public_discussion",
    "languages": [
      "en"
    ],
    "request_policy": {
      "max_concurrent_requests_per_host": 1,
      "min_interval_seconds_per_host": 10,
      "google_search_min_interval_seconds": 45,
      "honor_retry_after": true,
      "retry_backoff_seconds": [
        60,
        300,
        900
      ],
      "max_requests_per_run": 12,
      "stop_on_403_429_or_access_denial": true,
      "automatic_retry_after_denial": false,
      "shared_circuit_paths": [
        "/mnt/quant-state/quant-web/news_circuit.json"
      ],
      "min_interval_seconds_global": 10
    },
    "source_classes": [
      "official_product_announcements",
      "reputable_technology_news",
      "public_forums_and_communities",
      "public_product_reviews_and_benchmarks"
    ],
    "product_watchlist": [
      "Muse",
      "Gemini Agent",
      "GPT",
      "ChatGPT"
    ],
    "disambiguation": "Muse is ambiguous; include a result only when context supports that it refers to an AI product, model, or agent, and record the identified product/vendor when possible.",
    "sources": [
      {
        "name": "google-ai-announcements",
        "type": "rss",
        "url": "https://blog.google/technology/ai/rss/",
        "language": "en",
        "source_class": "official_product_announcements"
      },
      {
        "name": "openai-announcements",
        "type": "rss",
        "url": "https://openai.com/news/rss.xml",
        "language": "en",
        "source_class": "official_product_announcements"
      },
      {
        "name": "hacker-news-ai-discussion",
        "type": "rss",
        "url": "https://news.ycombinator.com/rss",
        "language": "en",
        "source_class": "public_forums_and_communities",
        "include_keywords": [
          "muse",
          "gemini",
          "gpt",
          "chatgpt",
          "openai",
          "agent",
          "agents",
          "llm"
        ]
      }
    ]
  },
  "options": {
    "start_jitter_seconds": 300,
    "lookback_hours": 72,
    "max_items_per_run": 200,
    "measure": [
      "discussion_volume_and_change",
      "engagement_signals_when_available",
      "user_sentiment_with_evidence",
      "reported_use_cases_and_outcomes",
      "recurring_strengths_and_pain_points",
      "product_comparisons_and_switching"
    ],
    "separate_anecdotes_from_representative_metrics": true,
    "output_artifact_types": [
      "timeline",
      "logic",
      "inferences",
      "relations",
      "summaries"
    ],
    "collection_stage": "news_discovery_only"
  },
  "schedule_format": "cron",
  "execution": {
    "command": [
      ".venv/bin/python",
      "-m",
      "collectors.news"
    ],
    "working_dir": ".",
    "timeout_seconds": 1800,
    "lock_group": "web-fetch"
  },
  "task_type": "crawl",
  "workflow": {
    "website_repo": "/mnt/quant/strategies/stocks-quant",
    "stage": "news_discovery",
    "outputs": [
      "data/raw",
      "data/normalized",
      "documents"
    ],
    "publication_status": "requires_topic_analysis_and_website_adapter"
  }
}
