{
  "id": "daily-blog-readiness",
  "name": "每周研究博客：写作前材料检查",
  "description": "周五、周日19:20与21:20核对当期材料，非发布日直接跳过；本地检查完整正文、覆盖日期、未使用来源及上游结果，不调用模型。",
  "scheduler_engine": "news-claw",
  "task_type": "workflow",
  "enabled": true,
  "schedule": "20 19,21 * * 0,5",
  "schedule_format": "cron",
  "timezone": "Asia/Shanghai",
  "topic_ids": [
    "daily-research-blog"
  ],
  "options": {
    "start_jitter_seconds": 0
  },
  "execution": {
    "command": [
      "/mnt/quant/strategies/stocks-quant/web/.venv/bin/python",
      "-m",
      "workflows.blog_delivery"
    ],
    "working_dir": ".",
    "timeout_seconds": 180,
    "stop_grace_seconds": 15,
    "lock_group": "blog-checks"
  },
  "workflow": {
    "blog_task_id": "daily-blog-agy-codex",
    "mode": "readiness",
    "network_requests": 0,
    "model_calls": 0
  }
}
