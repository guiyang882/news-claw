{
  "id": "daily-blog-readiness",
  "name": "每日研究博客：写作前材料检查",
  "description": "本地检查正文数量、来源日期、近期未使用资料和上游运行结果，不调用模型、不联网。",
  "scheduler_engine": "news-claw",
  "task_type": "workflow",
  "enabled": true,
  "schedule": "20 7,9 * * *",
  "schedule_format": "cron",
  "timezone": "Asia/Shanghai",
  "topic_ids": [
    "daily-research-blog"
  ],
  "options": {
    "start_jitter_seconds": 0
  },
  "execution": {
    "command": [
      "/mnt/quant/strategies/stocks-quant/web/.venv/bin/python",
      "-m",
      "workflows.blog_delivery"
    ],
    "working_dir": ".",
    "timeout_seconds": 180,
    "stop_grace_seconds": 15,
    "lock_group": "blog-checks"
  },
  "workflow": {
    "blog_task_id": "daily-blog-agy-codex",
    "mode": "readiness",
    "network_requests": 0,
    "model_calls": 0
  }
}
