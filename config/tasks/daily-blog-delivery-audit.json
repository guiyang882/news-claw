{
  "id": "daily-blog-delivery-audit",
  "name": "每周研究博客：当期发布结果核对",
  "description": "周五、周日22:55与23:55核对当期双语文章、哈希及本机页面。非发布日跳过；失败记录差异，不自动重写或重新采集。",
  "scheduler_engine": "news-claw",
  "task_type": "workflow",
  "enabled": true,
  "schedule": "55 22,23 * * 0,5",
  "schedule_format": "cron",
  "timezone": "Asia/Shanghai",
  "topic_ids": [
    "daily-research-blog"
  ],
  "options": {
    "start_jitter_seconds": 0
  },
  "execution": {
    "command": [
      "/mnt/quant/strategies/stocks-quant/web/.venv/bin/python",
      "-m",
      "workflows.blog_delivery"
    ],
    "working_dir": ".",
    "timeout_seconds": 180,
    "stop_grace_seconds": 15,
    "lock_group": "blog-checks"
  },
  "workflow": {
    "blog_task_id": "daily-blog-agy-codex",
    "mode": "delivery",
    "network_requests": 0,
    "model_calls": 0,
    "delivery_surfaces": {
      "enabled": true,
      "origin": "http://127.0.0.1:3000",
      "external_requests": 0,
      "max_response_bytes": 8000000
    },
    "local_http_checks": true
  }
}
