{
  "id": "daily-blog-delivery-audit",
  "name": "每日研究博客：发布结果核对",
  "description": "校验当天文章及双语内容哈希；缺文时记录失败原因、检查点和处理建议，不自动重写。",
  "scheduler_engine": "news-claw",
  "task_type": "workflow",
  "enabled": true,
  "schedule": "55 10 * * *",
  "schedule_format": "cron",
  "timezone": "Asia/Shanghai",
  "topic_ids": [
    "daily-research-blog"
  ],
  "options": {
    "start_jitter_seconds": 0
  },
  "execution": {
    "command": [
      "/mnt/quant/strategies/stocks-quant/web/.venv/bin/python",
      "-m",
      "workflows.blog_delivery"
    ],
    "working_dir": ".",
    "timeout_seconds": 180,
    "stop_grace_seconds": 15,
    "lock_group": "blog-checks"
  },
  "workflow": {
    "blog_task_id": "daily-blog-agy-codex",
    "mode": "delivery",
    "network_requests": 0,
    "model_calls": 0
  }
}
