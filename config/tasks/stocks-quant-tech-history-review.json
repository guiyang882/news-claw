{
  "id": "stocks-quant-tech-history-review",
  "name": "每周科技史故事研究",
  "description": "每周使用内置缓存搜索索引，为未来 30 天科技史纪念日准备有来源证据的中英文故事候选。",
  "scheduler_engine": "news-claw",
  "enabled": true,
  "schedule": "20 4 * * 1",
  "timezone": "Asia/Shanghai",
  "schedule_format": "cron",
  "topic_ids": [
    "technology-history-stories"
  ],
  "collector": {
    "type": "cached_web_search_research",
    "source_repo": "/mnt/quant/strategies/stocks-quant",
    "systemd_unit": "quant-tech-history-review.timer",
    "execution_owner": "news-claw_via_legacy_service",
    "external_timer_active": false,
    "observed_at": "2026-10-10",
    "allowed_domains": [
      "nasa.gov",
      "si.edu",
      "loc.gov",
      "computerhistory.org",
      "home.cern",
      "cern.ch",
      "esa.int",
      "isro.gov.in",
      "nps.gov",
      "ieee.org",
      "acm.org",
      "sciencehistory.org",
      "royalsociety.org",
      "nobelprize.org"
    ],
    "max_search_requests_per_run": 6,
    "min_interval_seconds": 10,
    "serial_requests": true,
    "live_source_fetching": false,
    "cooldown_days": 6,
    "randomized_delay": "up to 10 minutes",
    "stop_on_403_429_captcha_or_access_denial": true,
    "automatic_retry_after_denial": false,
    "migration_observed_at": "2026-10-10T08:44:00+00:00"
  },
  "options": {
    "migration_state": "go_scheduled_legacy_service",
    "max_stories_per_run": 7,
    "start_jitter_seconds": 600,
    "model_permissions": "full_no_interactive_approval"
  },
  "legacy_schedule": {
    "schedule": "Mon *-*-* 04:20:00",
    "format": "systemd_oncalendar",
    "timer": "quant-tech-history-review.timer"
  },
  "execution": {
    "command": [
      ".venv/bin/python",
      "-m",
      "collectors.legacy_service",
      "--unit",
      "quant-tech-history-review.service"
    ],
    "working_dir": ".",
    "timeout_seconds": 2160,
    "stop_grace_seconds": 115,
    "lock_group": "web-fetch",
    "adapter": "legacy_service",
    "systemd_unit": "quant-tech-history-review.service",
    "recovery_command": [
      "systemctl",
      "stop",
      "quant-tech-history-review.service"
    ],
    "recovery_timeout_seconds": 110
  },
  "task_type": "codex",
  "workflow": {
    "codex": {
      "model": "gpt-6.1-sol",
      "reasoning_effort": "medium",
      "service_tier": "default",
      "permissions": "full"
    },
    "website_repo": "/mnt/quant/strategies/stocks-quant",
    "website_runtime": {
      "stack": "nginx-nextjs-python",
      "proxy": "nginx",
      "frontend_service": "quant-next-web.service",
      "content_service": "quant-web.service",
      "proxy_service": "nginx.service",
      "content_update_action": "none",
      "content_reload_command": [
        "systemctl",
        "kill",
        "--kill-whom=main",
        "--signal=HUP",
        "quant-web.service"
      ],
      "frontend_restart_command": [
        "systemctl",
        "restart",
        "quant-next-web.service"
      ],
      "proxy_validate_command": [
        "/usr/sbin/nginx",
        "-t"
      ],
      "proxy_reload_command": [
        "systemctl",
        "reload",
        "nginx.service"
      ],
      "frontend_deployment": {
        "source_dir": "/mnt/quant/strategies/stocks-quant/web/frontend",
        "runbook": "/mnt/quant/strategies/stocks-quant/deployment/NEXTJS.md",
        "policy": "candidate_build_smoke_atomic_switch",
        "build_in_running_directory": false,
        "retain_previous_static_chunks": true,
        "steps": [
          "build_and_typecheck_in_separate_candidate_directory",
          "smoke_test_candidate",
          "retain_previous_static_chunks",
          "stop_frontend",
          "atomically_install_candidate_next_artifacts",
          "verify_service_user_file_permissions",
          "start_frontend",
          "verify_local_and_https_pages"
        ],
        "runtime_content_requires_frontend_build": false,
        "shared_credentials": "controlled_environment_only_not_task_json_or_logs",
        "candidate_build": {
          "working_dir": "<separate_candidate_repo_root>",
          "command": [
            "make",
            "test-frontend",
            "build-frontend"
          ]
        },
        "candidate_smoke": {
          "working_dir": "/mnt/quant/strategies/stocks-quant",
          "command": [
            "/mnt/quant/strategies/stocks-quant/web/.venv/bin/python",
            "web/frontend/scripts/smoke.py",
            "--frontend-dir",
            "<candidate_frontend_dir>"
          ]
        }
      },
      "health": {
        "host": "growthyoung.com",
        "content_port": 8000,
        "frontend_port": 3000,
        "https_port": 443,
        "content_path": "/healthz",
        "frontend_path": "/blog",
        "frontend_body_marker": "RESEARCH LIBRARY",
        "timeout_seconds": 10
      },
      "command_timeout_seconds": 30,
      "readiness_wait_seconds": 30
    },
    "outputs": [
      "/mnt/quant-state/quant-web/tech_history.json"
    ],
    "website_delivery": {
      "kind": "validated_runtime_snapshot",
      "reader": "Next.js via authenticated local Python content bridge",
      "after_publish": "none",
      "frontend_build_required": false,
      "restart_required": false
    }
  }
}
