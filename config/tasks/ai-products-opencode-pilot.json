{
  "id": "ai-products-opencode-pilot",
  "name": "AI产品反馈：OpenCode DeepSeek独立试点（备用关闭）",
  "description": "正式AI产品摘要任务已使用修正后的OpenCode配置；本任务保持关闭以免重复处理。",
  "scheduler_engine": "news-claw",
  "task_type": "workflow",
  "enabled": false,
  "schedule": "47 11,19 * * *",
  "timezone": "Asia/Shanghai",
  "schedule_format": "cron",
  "topic_ids": [
    "ai-products-attention-feedback"
  ],
  "options": {
    "start_jitter_seconds": 420,
    "model_permissions": "noninteractive_ask_auto_reject"
  },
  "execution": {
    "command": [
      "/mnt/quant/strategies/stocks-quant/web/.venv/bin/python",
      "-m",
      "workflows.topic_summary"
    ],
    "working_dir": ".",
    "timeout_seconds": 2400,
    "stop_grace_seconds": 15,
    "lock_group": "model-cli",
    "env": {
      "PYTHONDONTWRITEBYTECODE": "1",
      "HOME": "/root",
      "CODEX_HOME": "/root/.codex"
    }
  },
  "workflow": {
    "kind": "reviewed-topic-summary-v1",
    "writer": {
      "executable": "/usr/local/bin/opencode",
      "model": "opencode/deepseek-v4.1-flash-free",
      "timeout_seconds": 600,
      "permissions": "noninteractive-ask-auto-reject",
      "max_calls_per_day": 3
    },
    "reviewer": {
      "executable": "/usr/local/bin/codex",
      "model": "gpt-6.1-sol",
      "timeout_seconds": 420,
      "permissions": "full",
      "service_tier": "default",
      "reasoning_effort": "medium"
    },
    "min_model_interval_seconds": 10,
    "inputs": {
      "lookback_days": 3,
      "max_documents": 16,
      "max_text_chars": 1400,
      "min_sources": 2,
      "max_snapshot_age_days": 14,
      "max_legacy_headlines": 0,
      "company_pulses": "/mnt/quant-state/quant-web/company_pulses.json",
      "news_timeline": "/mnt/quant-state/quant-web/news_timeline.json",
      "snapshot_companies": {}
    },
    "stages": [
      "opencode_summary",
      "codex_review",
      "codex_correction_if_needed",
      "codex_re_review_if_corrected",
      "save_approved_knowledge"
    ],
    "network_policy": {
      "source_web_requests": 0,
      "max_cli_invocations_per_run": 4,
      "automatic_retries": 0,
      "provider_denial": "persistent_circuit_requires_explicit_reset",
      "paid_fallback": false
    },
    "outputs": [
      "data/runs/<run_id>/source-packet.json",
      "data/runs/<run_id>/01-agy-summary/response.json",
      "data/runs/<run_id>/validated-summary.json",
      "data/runs/<run_id>/02-codex-review/response.json",
      "data/knowledge/topics/<topic_id>/summaries/<task_id>-<input_fingerprint>.json",
      "data/knowledge/topics/<topic_id>/summaries/<task_id>-<input_fingerprint>.md",
      "data/runs/<run_id>/03-codex-correction/response.json",
      "data/runs/<run_id>/04-codex-re-review/response.json"
    ],
    "website_repo": "/mnt/quant/strategies/stocks-quant",
    "website_runtime": {
      "stack": "nginx-nextjs-python",
      "proxy": "nginx",
      "frontend_service": "quant-next-web.service",
      "content_service": "quant-web.service",
      "proxy_service": "nginx.service",
      "content_update_action": "none",
      "content_reload_command": [
        "systemctl",
        "kill",
        "--kill-whom=main",
        "--signal=HUP",
        "quant-web.service"
      ],
      "frontend_restart_command": [
        "systemctl",
        "restart",
        "quant-next-web.service"
      ],
      "proxy_validate_command": [
        "/usr/sbin/nginx",
        "-t"
      ],
      "proxy_reload_command": [
        "systemctl",
        "reload",
        "nginx.service"
      ],
      "frontend_deployment": {
        "source_dir": "/mnt/quant/strategies/stocks-quant/web/frontend",
        "runbook": "/mnt/quant/strategies/stocks-quant/deployment/NEXTJS.md",
        "policy": "candidate_build_smoke_atomic_switch",
        "build_in_running_directory": false,
        "retain_previous_static_chunks": true,
        "steps": [
          "build_and_typecheck_in_separate_candidate_directory",
          "smoke_test_candidate",
          "retain_previous_static_chunks",
          "stop_frontend",
          "atomically_install_candidate_next_artifacts",
          "verify_service_user_file_permissions",
          "start_frontend",
          "verify_local_and_https_pages"
        ],
        "runtime_content_requires_frontend_build": false,
        "shared_credentials": "controlled_environment_only_not_task_json_or_logs",
        "candidate_build": {
          "working_dir": "<separate_candidate_repo_root>",
          "command": [
            "make",
            "test-frontend",
            "build-frontend"
          ]
        },
        "candidate_smoke": {
          "working_dir": "/mnt/quant/strategies/stocks-quant",
          "command": [
            "/mnt/quant/strategies/stocks-quant/web/.venv/bin/python",
            "web/frontend/scripts/smoke.py",
            "--frontend-dir",
            "<candidate_frontend_dir>"
          ]
        }
      },
      "health": {
        "host": "growthyoung.com",
        "content_port": 8000,
        "frontend_port": 3000,
        "https_port": 443,
        "content_path": "/healthz",
        "frontend_path": "/blog",
        "frontend_body_marker": "RESEARCH LIBRARY",
        "timeout_seconds": 10
      },
      "command_timeout_seconds": 30,
      "readiness_wait_seconds": 30
    },
    "website_delivery": {
      "kind": "reviewed_topic_knowledge",
      "reader": "daily blog planning with original cached evidence",
      "after_publish": "none",
      "frontend_build_required": false,
      "restart_required": false
    },
    "max_summary_revisions": 1,
    "writer_provider": "opencode",
    "pilot": {
      "state": "standby_to_avoid_duplicate_processing",
      "baseline_task": "ai-products-gemini-summary",
      "historical_failed_run_id": "349dbe9add4fddc390e9dca8c3964974",
      "configuration_fix": "Native ask permissions with non-interactive auto-rejection; no --auto"
    }
  }
}
