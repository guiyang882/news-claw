{
  "id": "daily-blog-agy-codex",
  "name": "每日研究博客：Gemini写稿、Codex复核与发布",
  "description": "Codex 从本地缓存生成候选选题和约20分钟阅读大纲，agy/Gemini 3.8 Flash 按大纲写中英双语长文，GPT-6.1 Sol 复核、humanizer修订及最终复核后发布；每日最多一篇。",
  "scheduler_engine": "news-claw",
  "task_type": "workflow",
  "enabled": true,
  "schedule": "30 7 * * *",
  "timezone": "Asia/Shanghai",
  "schedule_format": "cron",
  "topic_ids": [
    "us-china-export-controls",
    "ai-products-attention-feedback",
    "robotics-and-humanoids",
    "physical-ai",
    "space-race",
    "daily-research-blog"
  ],
  "options": {
    "start_jitter_seconds": 420,
    "model_permissions": "full_no_interactive_approval"
  },
  "execution": {
    "command": [
      "/mnt/quant/strategies/stocks-quant/web/.venv/bin/python",
      "-m",
      "workflows.daily_blog"
    ],
    "working_dir": ".",
    "timeout_seconds": 4500,
    "stop_grace_seconds": 15,
    "lock_group": "model-cli",
    "env": {
      "PYTHONDONTWRITEBYTECODE": "1",
      "HOME": "/root",
      "CODEX_HOME": "/root/.codex"
    }
  },
  "workflow": {
    "website_repo": "/mnt/quant/strategies/stocks-quant",
    "website_state": "/mnt/quant-state/quant-web/blog",
    "public_base_url": "https://growthyoung.com",
    "writer": {
      "executable": "/root/.local/bin/agy",
      "model": "gemini-3.8-flash-high",
      "timeout_seconds": 1200,
      "permissions": "full"
    },
    "reviewer": {
      "executable": "/usr/local/bin/codex",
      "model": "gpt-6.1-sol",
      "timeout_seconds": 300,
      "permissions": "full",
      "service_tier": "fast",
      "reasoning_effort": null
    },
    "humanizer_skill": "/root/.codex/skills/humanizer/SKILL.md",
    "min_model_interval_seconds": 10,
    "inputs": {
      "lookback_days": 2,
      "max_documents": 30,
      "max_text_chars": 4000,
      "max_legacy_headlines": 18,
      "max_snapshot_age_days": 14,
      "company_pulses": "/mnt/quant-state/quant-web/company_pulses.json",
      "news_timeline": "/mnt/quant-state/quant-web/news_timeline.json"
    },
    "stages": [
      "codex_topics_and_outline",
      "agy_draft",
      "codex_length_repair_if_needed",
      "codex_fact_review",
      "codex_correction_if_rejected",
      "codex_re_review_if_corrected",
      "codex_humanizer",
      "codex_final_review",
      "codex_final_correction_if_rejected",
      "codex_final_re_review_if_corrected",
      "offline_publish"
    ],
    "publication_policy": "User-authorized model-reviewed publication; never generates human approvals. Reject unsupported claims; preserve evidence dates; one attempt and one article per day.",
    "network_policy": {
      "source_web_requests": 0,
      "max_cli_invocations_per_day": 10,
      "automatic_retries": 0,
      "provider_denial": "persistent_circuit_requires_explicit_reset"
    },
    "outputs": [
      "data/runs/<run_id>/source-packet.json",
      "data/runs/<run_id>/topic-candidates.json",
      "data/runs/<run_id>/blog-outline.json",
      "data/runs/<run_id>/blog-outline.md",
      "data/runs/<run_id>/final-draft.json",
      "/mnt/quant-state/quant-web/blog/automation-reviews/<slug>.json",
      "/mnt/quant-state/quant-web/blog/manifest.json"
    ],
    "max_draft_revisions": 1,
    "planner": {
      "executable": "/usr/local/bin/codex",
      "model": "gpt-6.1-sol",
      "timeout_seconds": 300,
      "permissions": "full",
      "service_tier": "fast",
      "reasoning_effort": null
    },
    "planning": {
      "max_candidates": 3,
      "min_sections": 6,
      "max_sections": 9,
      "selection_policy": "Evidence depth, concrete reader value, distinct angle, and no repetition of recent articles; no padding to meet length."
    },
    "reading": {
      "target_minutes": 20,
      "tolerance_minutes": 3,
      "zh_units_per_minute": 300,
      "en_words_per_minute": 200
    },
    "stage_timeout_seconds": {
      "revise": 900,
      "humanize": 900,
      "repair_length": 900,
      "revise_final": 900
    },
    "editorial_skill": "/root/.codex/skills/research-blog-editor/SKILL.md",
    "max_length_repairs": 1,
    "max_final_revisions": 1,
    "presentation": {
      "slug_style": "topic-date",
      "max_topic_words": 8,
      "media_catalog": "config/media/approved-assets.json",
      "preferred_tables": 2,
      "preferred_diagrams": 2,
      "emphasis": "restrained_bold_italic_underline",
      "public_process_notes": false,
      "references": "source_based_appendix"
    }
  }
}
