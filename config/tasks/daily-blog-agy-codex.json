{
  "id": "daily-blog-agy-codex",
  "name": "每日研究博客：Gemini写稿、Codex复核与发布",
  "description": "从本地缓存选题，agy/Gemini 3.8 Flash 写中英双语稿，GPT-6.1 Sol 复核、humanizer修订及最终复核后发布到网站；每日最多一篇。",
  "scheduler_engine": "news-claw",
  "task_type": "workflow",
  "enabled": true,
  "schedule": "10 23 * * *",
  "timezone": "Asia/Shanghai",
  "schedule_format": "cron",
  "topic_ids": [
    "us-china-export-controls",
    "ai-products-attention-feedback",
    "robotics-and-humanoids",
    "physical-ai",
    "space-race",
    "daily-research-blog"
  ],
  "options": {
    "start_jitter_seconds": 420,
    "model_permissions": "full_no_interactive_approval"
  },
  "execution": {
    "command": [
      "/mnt/quant/strategies/stocks-quant/web/.venv/bin/python",
      "-m",
      "workflows.daily_blog"
    ],
    "working_dir": ".",
    "timeout_seconds": 2400,
    "stop_grace_seconds": 15,
    "lock_group": "model-cli",
    "env": {
      "PYTHONDONTWRITEBYTECODE": "1",
      "HOME": "/root",
      "CODEX_HOME": "/root/.codex"
    }
  },
  "workflow": {
    "website_repo": "/mnt/quant/strategies/stocks-quant",
    "website_state": "/mnt/quant-state/quant-web/blog",
    "public_base_url": "https://growthyoung.com",
    "writer": {
      "executable": "/root/.local/bin/agy",
      "model": "gemini-3.8-flash-high",
      "timeout_seconds": 600,
      "permissions": "full"
    },
    "reviewer": {
      "executable": "/usr/local/bin/codex",
      "model": "gpt-6.1-sol",
      "timeout_seconds": 300,
      "permissions": "full"
    },
    "humanizer_skill": "/root/.codex/skills/humanizer/SKILL.md",
    "min_model_interval_seconds": 10,
    "inputs": {
      "lookback_days": 2,
      "max_documents": 30,
      "max_text_chars": 4000,
      "max_legacy_headlines": 18,
      "max_snapshot_age_days": 14,
      "company_pulses": "/mnt/quant-state/quant-web/company_pulses.json",
      "news_timeline": "/mnt/quant-state/quant-web/news_timeline.json"
    },
    "stages": [
      "agy_draft",
      "codex_fact_review",
      "codex_correction_if_rejected",
      "codex_re_review_if_corrected",
      "codex_humanizer",
      "codex_final_review",
      "offline_publish"
    ],
    "publication_policy": "User-authorized model-reviewed publication; never generates human approvals. Reject unsupported claims; preserve evidence dates; one attempt and one article per day.",
    "network_policy": {
      "source_web_requests": 0,
      "max_cli_invocations_per_day": 6,
      "automatic_retries": 0,
      "provider_denial": "persistent_circuit_requires_explicit_reset"
    },
    "outputs": [
      "data/runs/<run_id>/source-packet.json",
      "data/runs/<run_id>/final-draft.json",
      "/mnt/quant-state/quant-web/blog/automation-reviews/<slug>.json",
      "/mnt/quant-state/quant-web/blog/manifest.json"
    ],
    "max_draft_revisions": 1
  }
}
