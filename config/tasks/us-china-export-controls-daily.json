{
  "id": "us-china-export-controls-daily",
  "name": "中美进出口管制政策追踪",
  "description": "每日追踪美国对华出口管制及相关贸易限制的政策变化、涉及行业和受影响公司。",
  "scheduler_engine": "news-claw",
  "enabled": true,
  "schedule": "15 7 * * *",
  "timezone": "Asia/Shanghai",
  "topic_ids": [
    "us-china-export-controls"
  ],
  "collector": {
    "type": "multi_source_news",
    "languages": [
      "en",
      "zh"
    ],
    "request_policy": {
      "max_concurrent_requests_per_host": 1,
      "min_interval_seconds_per_host": 10,
      "google_search_min_interval_seconds": 45,
      "honor_retry_after": true,
      "retry_backoff_seconds": [
        60,
        300,
        900
      ],
      "max_requests_per_run": 12,
      "stop_on_403_429_or_access_denial": true,
      "automatic_retry_after_denial": false,
      "shared_circuit_paths": [
        "/mnt/quant-state/quant-web/news_circuit.json"
      ],
      "min_interval_seconds_global": 10
    },
    "source_classes": [
      "us_government_primary_sources",
      "federal_register_and_regulatory_notices",
      "company_filings_and_announcements",
      "reputable_international_news"
    ],
    "priority_sources": [
      "BIS",
      "Federal Register",
      "USTR",
      "US Treasury",
      "US Congress"
    ],
    "sources": [
      {
        "name": "federal-register-china-trade",
        "type": "federal_register",
        "url": "https://www.federalregister.gov/api/v1/documents.json?per_page=50&order=newest&conditions%5Bterm%5D=China",
        "language": "en",
        "source_class": "us_government_primary_sources",
        "include_keywords": [
          "export",
          "import",
          "tariff",
          "sanction",
          "entity list",
          "semiconductor",
          "dual-use",
          "industry and security"
        ]
      }
    ]
  },
  "options": {
    "start_jitter_seconds": 300,
    "lookback_hours": 72,
    "max_items_per_run": 150,
    "track_policy_deltas": true,
    "identify_affected_industries_and_companies": true,
    "impact_labels": [
      "direct",
      "indirect",
      "uncertain"
    ],
    "output_artifact_types": [
      "timeline",
      "logic",
      "inferences",
      "relations",
      "summaries"
    ],
    "collection_stage": "news_discovery_only"
  },
  "schedule_format": "cron",
  "execution": {
    "command": [
      ".venv/bin/python",
      "-m",
      "collectors.news"
    ],
    "working_dir": ".",
    "timeout_seconds": 1800,
    "lock_group": "web-fetch"
  },
  "task_type": "crawl",
  "workflow": {
    "website_repo": "/mnt/quant/strategies/stocks-quant",
    "stage": "news_discovery",
    "outputs": [
      "data/raw",
      "data/normalized",
      "documents"
    ],
    "publication_status": "requires_topic_analysis_and_website_adapter"
  }
}
