        },
        {
          "url": "https://investors.micron.com/news/press-release/2024/Micron-Commences-Volume-Production-of-Industry-Leading-HBM3E-Solution-to-Accelerate-the-Growth-of-AI-02-26-2024/default.aspx",
          "name": "Micron — Micron commences HBM3E volume production",
          "published_at": "2024-02-26T00:00:00+00:00"
        },
        {
          "url": "https://blogs.nvidia.com/blog/tsmc-blackwell-manufacturing/",
          "name": "NVIDIA — First Blackwell wafer produced in the US",
          "published_at": "2025-10-17T00:00:00+00:00"
        },
        {
          "url": "https://blogs.nvidia.com/blog/nvidia-and-partners-build-in-america-for-america/",
          "name": "NVIDIA — NVIDIA and partners build in America",
          "published_at": "2026-08-05T00:00:00+00:00"
        },
        {
          "url": "https://www.apple.com/newsroom/2025/08/apple-increases-us-commitment-to-600-billion-usd-announces-ambitious-program/",
          "name": "Apple — Apple expands US investment program",
          "published_at": "2025-08-06T00:00:00+00:00"
        },
        {
          "url": "https://pr.tsmc.com/schinese/news/3192",
          "name": "TSMC — 2024 outstanding supplier awards",
          "published_at": "2024-12-02T00:00:00+00:00"
        }
      ]
    }
  },
  "options": {
    "start_jitter_seconds": 0,
    "lookback_hours": 8760,
    "max_items_per_run": 4
  },
  "execution": {
    "command": [
      ".venv/bin/python",
      "-m",
      "collectors.dependency_evidence",
      "--execute"
    ],
    "working_dir": ".",
    "timeout_seconds": 900,
    "stop_grace_seconds": 15,
    "lock_group": "web-fetch"
  },
  "workflow": {
    "website_repo": "/mnt/quant/strategies/stocks-quant",
    "website_runtime": {
      "stack": "nginx-nextjs-python",
      "proxy": "nginx",
      "frontend_service": "quant-next-web.service",
      "content_service": "quant-web.service",
      "proxy_service": "nginx.service",
      "content_update_action": "none",
      "content_reload_command": [
        "systemctl",
        "kill",
        "--kill-whom=main",
        "--signal=HUP",
        "quant-web.service"
      ],
      "frontend_restart_command": [
        "systemctl",
        "restart",
        "quant-next-web.service"
      ],
      "proxy_validate_command": [
        "/usr/sbin/nginx",
        "-t"
      ],
      "proxy_reload_command": [
        "systemctl",
        "reload",
        "nginx.service"
      ],
      "frontend_deployment": {
        "source_dir": "/mnt/quant/strategies/stocks-quant/web/frontend",
        "runbook": "/mnt/quant/strategies/stocks-quant/deployment/NEXTJS.md",
        "policy": "candidate_build_smoke_atomic_switch",
        "build_in_running_directory": false,
        "retain_previous_static_chunks": true,
        "steps": [
          "build_and_typecheck_in_separate_candidate_directory",
          "smoke_test_candidate",
          "retain_previous_static_chunks",
          "stop_frontend",
          "atomically_install_candidate_next_artifacts",
          "verify_service_user_file_permissions",
          "start_frontend",
          "verify_local_and_https_pages"
        ],
        "runtime_content_requires_frontend_build": false,
        "shared_credentials": "controlled_environment_only_not_task_json_or_logs",
        "candidate_build": {
          "working_dir": "<separate_candidate_repo_root>",
          "command": [
            "make",
            "test-frontend",
            "build-frontend"
          ]
        },
        "candidate_smoke": {
          "working_dir": "/mnt/quant/strategies/stocks-quant",
          "command": [
            "/mnt/quant/strategies/stocks-quant/web/.venv/bin/python",
            "web/frontend/scripts/smoke.py",
            "--frontend-dir",
            "<candidate_frontend_dir>"
          ]
        }
      },
      "health": {
        "host": "growthyoung.com",
        "content_port": 8000,
        "frontend_port": 3000,
        "https_port": 443,
        "content_path": "/healthz",
        "frontend_path": "/blog",
        "frontend_body_marker": "RESEARCH LIBRARY",
        "timeout_seconds": 10
      },
      "command_timeout_seconds": 30,
      "readiness_wait_seconds": 30
    },
    "website_delivery": {
      "kind": "cached_evidence",
      "reader": "Company dependencies evidence review",
      "after_publish": "none",
      "frontend_build_required": false,
      "restart_required": false
    }
  }
}
