        },
        {
          "url": "https://rocketlabcorp.com/updates/rocket-lab-delivers-second-spacecraft-completes-third-for-varda-space-industries/",
          "name": "Rocket Lab — Second Varda spacecraft delivered",
          "published_at": "2024-12-17T00:00:00+00:00"
        },
        {
