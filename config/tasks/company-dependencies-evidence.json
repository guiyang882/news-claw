        },
        {
          "url": "https://www.t-mobile.com/news/network/t-mobile-starlink-beta-open-for-all-carriers",
          "name": "T-Mobile — T-Mobile Starlink beta takes off",
          "published_at": "2025-02-09T00:00:00+00:00"
        },
        {
          "url": "https://news.panasonic.com/global/press/en161227-6",
          "name": "Panasonic — Tesla and Panasonic solar collaboration",
          "published_at": "2016-12-27T00:00:00+00:00"
        },
        {
          "url": "https://cloud.google.com/blog/topics/google-cloud-next/whats-next-for-digital-transformation-in-the-cloud",
          "name": "Google Cloud — What’s next for digital transformation in the cloud",
          "published_at": "2022-10-11T00:00:00+00:00"
        },
        {
          "url": "https://www.shopify.com/news/stablecoins-on-shopify",
          "name": "Shopify — Stablecoins on Shopify",
