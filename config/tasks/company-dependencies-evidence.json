{
  "id": "company-dependencies-evidence",
  "name": "八家公司上下游：官方正文采集",
  "description": "官方RSS正文与人工核对的公告队列，每次最多4篇、每域最多2篇；复用缓存，10秒间隔，拒绝即熔断。",
  "scheduler_engine": "news-claw",
  "task_type": "crawl",
  "enabled": true,
  "schedule": "20 7 * * *",
  "schedule_format": "cron",
  "timezone": "Asia/Shanghai",
  "topic_ids": [
    "daily-research-blog",
    "ai-products-attention-feedback",
    "robotics-and-humanoids",
    "physical-ai",
    "space-race"
  ],
  "collector": {
    "type": "public_primary_pages",
    "sources": [],
    "access_review": {
      "status": "public_issuer_disclosures",
      "reviewed_at": "2026-10-15",
      "authentication": "none_required",
      "scope": "Read public official announcements discovered from existing publisher feeds, obey robots and shared denial circuits; no recursive crawling, credentials, SEC, or denied origins. Also read exact reviewed public announcement URLs in discovery.reviewed_pages; no recursive discovery."
    },
    "request_policy": {
      "max_concurrent_requests_per_host": 1,
      "min_interval_seconds_per_host": 10,
      "min_interval_seconds_global": 10,
      "max_requests_per_run": 8,
      "automatic_retry_after_denial": false,
      "stop_on_403_429_or_access_denial": true
    },
    "discovery": {
      "lookback_days": 30,
      "max_pages_per_run": 4,
      "max_pages_per_host": 2,
      "official_url_prefixes": [
        "https://blog.google/innovation-and-ai/",
        "https://blog.google/company-news/",
        "https://blogs.nvidia.com/blog/",
        "https://nvidianews.nvidia.com/news/",
        "https://aws.amazon.com/blogs/aws/",
        "https://www.nasa.gov/news-release/",
        "https://science.nasa.gov/",
        "https://rocketlabcorp.com/updates/rocket-lab-completes-mynaric-acquisition-adding-laser-optical-communications-to-growing-space-systems-portfolio/index.php",
        "https://rocketlabcorp.com/updates/rocket-lab-delivers-second-spacecraft-completes-third-for-varda-space-industries/",
        "https://rocketlabcorp.com/updates/rocket-lab-spacecraft-built-for-varda-successfully-operating-on-orbit/",
        "https://www.t-mobile.com/news/network/t-mobile-activates-t-satellite-and-mobilizes-network-teams-tropical-storm-lala-hawaii",
        "https://www.t-mobile.com/news/network/t-mobile-starlink-beta-open-for-all-carriers",
        "https://news.panasonic.com/global/press/en161227-6",
        "https://cloud.google.com/blog/topics/google-cloud-next/whats-next-for-digital-transformation-in-the-cloud",
        "https://www.shopify.com/news/stablecoins-on-shopify",
        "https://investors.micron.com/news/press-release/2024/Micron-Commences-Volume-Production-of-Industry-Leading-HBM3E-Solution-to-Accelerate-the-Growth-of-AI-02-26-2024/default.aspx",
        "https://blogs.nvidia.com/blog/tsmc-blackwell-manufacturing/",
        "https://blogs.nvidia.com/blog/nvidia-and-partners-build-in-america-for-america/",
        "https://www.apple.com/newsroom/2025/08/apple-increases-us-commitment-to-600-billion-usd-announces-ambitious-program/",
        "https://pr.tsmc.com/schinese/news/3192"
      ],
      "official_feed_hosts": [
        "blog.google",
        "blogs.nvidia.com",
        "nvidianews.nvidia.com",
        "aws.amazon.com",
        "www.nasa.gov"
      ],
      "title_pattern": "partnership|partner|supply|supplier|customer|manufactur|launch|chip|foundry|cloud|contract|agreement|collaborat|battery|USDC|custody|satellite|semiconductor",
      "reviewed_pages": [
        {
          "url": "https://rocketlabcorp.com/updates/rocket-lab-completes-mynaric-acquisition-adding-laser-optical-communications-to-growing-space-systems-portfolio/index.php",
          "name": "Rocket Lab — Mynaric acquisition completed",
