{
  "id": "robotics-physical-ai-space-daily",
  "name": "机器人、物理 AI 与太空竞赛新闻科技追踪",
  "description": "每天两次汇总机器人、物理 AI、太空竞赛的新闻和技术进展，并关联重点公司与参与方。",
  "scheduler_engine": "news-claw",
  "enabled": true,
  "schedule": "15 14,22 * * *",
  "timezone": "Asia/Shanghai",
  "topic_ids": [
    "robotics-and-humanoids",
    "physical-ai",
    "space-race"
  ],
  "collector": {
    "type": "multi_source_news",
    "languages": [
      "en",
      "zh"
    ],
    "request_policy": {
      "max_concurrent_requests_per_host": 1,
      "min_interval_seconds_per_host": 10,
      "google_search_min_interval_seconds": 60,
      "honor_retry_after": true,
      "retry_backoff_seconds": [
        60,
        300,
        900
      ],
      "max_requests_per_run": 12,
      "stop_on_403_429_or_access_denial": true,
      "automatic_retry_after_denial": false,
      "shared_circuit_paths": [
        "/mnt/quant-state/quant-web/news_circuit.json"
      ],
      "min_interval_seconds_global": 10
    },
    "source_classes": [
      "company_announcements_and_filings",
      "reputable_technology_and_business_news",
      "research_papers_and_conference_updates",
      "government_and_space_agency_updates"
    ],
    "entity_watchlist": [
      "SpaceX",
      "Tesla",
      "Rocket Lab",
      "Figure AI",
      "Boston Dynamics",
      "Agility Robotics",
      "1X Technologies",
      "NVIDIA",
      "Blue Origin",
      "NASA",
      "ULA"
    ],
    "discover_related_entities": true,
    "sources": [
      {
        "name": "space-race",
        "type": "rss",
        "url": "https://news.google.com/rss/search?q=%28SpaceX+OR+%22Rocket+Lab%22+OR+%22Blue+Origin%22%29+when%3A1d&hl=en-US&gl=US&ceid=US%3Aen",
        "language": "en",
        "source_class": "public_news_discovery",
        "obey_robots_txt": false,
        "topic_ids": [
          "space-race"
        ]
      },
      {
        "name": "robotics",
        "type": "rss",
        "url": "https://news.google.com/rss/search?q=%28Tesla+Optimus+OR+%22Figure+AI%22+OR+humanoid+robotics%29+when%3A1d&hl=en-US&gl=US&ceid=US%3Aen",
        "language": "en",
        "source_class": "public_news_discovery",
        "obey_robots_txt": false,
        "topic_ids": [
          "robotics-and-humanoids",
          "physical-ai"
        ]
      },
      {
        "name": "physical-ai",
        "type": "rss",
        "url": "https://news.google.com/rss/search?q=%22physical+AI%22+%28NVIDIA+OR+robotics+OR+research%29+when%3A1d&hl=en-US&gl=US&ceid=US%3Aen",
        "language": "en",
        "source_class": "public_news_discovery",
        "obey_robots_txt": false,
        "topic_ids": [
          "physical-ai"
        ]
      },
      {
        "name": "nasa-news-releases",
        "type": "rss",
        "url": "https://www.nasa.gov/news-release/feed/",
        "language": "en",
        "source_class": "government_and_space_agency_updates",
        "include_keywords": [
          "spacex",
          "rocket lab",
          "commercial",
          "launch",
          "artemis",
          "space station"
        ],
        "topic_ids": [
          "space-race"
        ]
      },
      {
        "name": "nvidia-robotics",
        "type": "rss",
        "url": "https://blogs.nvidia.com/feed/",
        "language": "en",
        "source_class": "company_announcements_and_filings",
        "include_keywords": [
          "robot",
          "robots",
          "robotics",
          "humanoid",
          "humanoids",
          "physical ai",
          "tesla",
          "optimus",
          "simulation"
        ],
        "topic_ids": [
          "robotics-and-humanoids",
          "physical-ai"
        ]
      }
    ],
    "unavailable_sources": [
      {
        "name": "rocket-lab-investor-news",
        "url": "https://investors.rocketlabcorp.com/rss/news-releases.xml",
        "reason": "HTTP 403 during robots permission check; persistent circuit open; not scheduled",
        "checked_at": "2026-10-11T13:51:40+00:00"
      }
    ],
    "robots_override": {
      "scope": "explicit_google_news_rss_urls_only",
      "requested_by": "user",
      "reason": "User explicitly requested Google News RSS restoration and ignoring robots for these feeds.",
      "requested_at": "2026-10-11",
      "http_denial_and_rate_limit_circuits_retained": true
    }
  },
  "options": {
    "start_jitter_seconds": 300,
    "lookback_hours": 72,
    "max_items_per_run": 250,
    "summarize": [
      "news_and_company_developments",
      "technical_progress_and_evidence",
      "product_and_deployment_milestones",
      "competition_and_partnerships",
      "risks_and_open_questions"
    ],
    "output_artifact_types": [
      "timeline",
      "logic",
      "inferences",
      "relations",
      "summaries"
    ],
    "collection_stage": "news_discovery_only"
  },
  "schedule_format": "cron",
  "execution": {
    "command": [
      ".venv/bin/python",
      "-m",
      "collectors.news"
    ],
    "working_dir": ".",
    "timeout_seconds": 1800,
    "lock_group": "web-fetch"
  },
  "task_type": "crawl",
  "workflow": {
    "website_repo": "/mnt/quant/strategies/stocks-quant",
    "stage": "news_discovery",
    "outputs": [
      "data/raw",
      "data/normalized",
      "documents"
    ],
    "publication_status": "feeds_daily_blog_workflow_not_direct_webpage_publication",
    "website_runtime": {
      "stack": "nginx-nextjs-python",
      "proxy": "nginx",
      "frontend_service": "quant-next-web.service",
      "content_service": "quant-web.service",
      "proxy_service": "nginx.service",
      "content_update_action": "none",
      "content_reload_command": [
        "systemctl",
        "kill",
        "--kill-whom=main",
        "--signal=HUP",
        "quant-web.service"
      ],
      "frontend_restart_command": [
        "systemctl",
        "restart",
        "quant-next-web.service"
      ],
      "proxy_validate_command": [
        "/usr/sbin/nginx",
        "-t"
      ],
      "proxy_reload_command": [
        "systemctl",
        "reload",
        "nginx.service"
      ],
      "frontend_deployment": {
        "source_dir": "/mnt/quant/strategies/stocks-quant/web/frontend",
        "runbook": "/mnt/quant/strategies/stocks-quant/deployment/NEXTJS.md",
        "policy": "candidate_build_smoke_atomic_switch",
        "build_in_running_directory": false,
        "retain_previous_static_chunks": true,
        "steps": [
          "build_and_typecheck_in_separate_candidate_directory",
          "smoke_test_candidate",
          "retain_previous_static_chunks",
          "stop_frontend",
          "atomically_install_candidate_next_artifacts",
          "verify_service_user_file_permissions",
          "start_frontend",
          "verify_local_and_https_pages"
        ],
        "runtime_content_requires_frontend_build": false,
        "shared_credentials": "controlled_environment_only_not_task_json_or_logs",
        "candidate_build": {
          "working_dir": "<separate_candidate_repo_root>",
          "command": [
            "make",
            "test-frontend",
            "build-frontend"
          ]
        },
        "candidate_smoke": {
          "working_dir": "/mnt/quant/strategies/stocks-quant",
          "command": [
            "/mnt/quant/strategies/stocks-quant/web/.venv/bin/python",
            "web/frontend/scripts/smoke.py",
            "--frontend-dir",
            "<candidate_frontend_dir>"
          ]
        }
      },
      "health": {
        "host": "growthyoung.com",
        "content_port": 8000,
        "frontend_port": 3000,
        "https_port": 443,
        "content_path": "/healthz",
        "frontend_path": "/blog",
        "frontend_body_marker": "RESEARCH LIBRARY",
        "timeout_seconds": 10
      },
      "command_timeout_seconds": 30,
      "readiness_wait_seconds": 30
    },
    "website_delivery": {
      "kind": "local_evidence",
      "reader": "daily-blog source packet; no direct website publication",
      "after_publish": "none",
      "frontend_build_required": false,
      "restart_required": false
    }
  }
}
