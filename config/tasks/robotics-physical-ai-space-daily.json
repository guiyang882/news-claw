{
  "id": "robotics-physical-ai-space-daily",
  "name": "机器人、物理 AI 与太空竞赛新闻科技追踪",
  "description": "每天两次汇总机器人、物理 AI、太空竞赛的新闻和技术进展，并关联重点公司与参与方。",
  "scheduler_engine": "news-claw",
  "enabled": true,
  "schedule": "15 14,22 * * *",
  "timezone": "Asia/Shanghai",
  "topic_ids": [
    "robotics-and-humanoids",
    "physical-ai",
    "space-race"
  ],
  "collector": {
    "type": "multi_source_news",
    "languages": [
      "en",
      "zh"
    ],
    "request_policy": {
      "max_concurrent_requests_per_host": 1,
      "min_interval_seconds_per_host": 10,
      "google_search_min_interval_seconds": 45,
      "honor_retry_after": true,
      "retry_backoff_seconds": [
        60,
        300,
        900
      ],
      "max_requests_per_run": 12,
      "stop_on_403_429_or_access_denial": true,
      "automatic_retry_after_denial": false
    },
    "source_classes": [
      "company_announcements_and_filings",
      "reputable_technology_and_business_news",
      "research_papers_and_conference_updates",
      "government_and_space_agency_updates"
    ],
    "entity_watchlist": [
      "SpaceX",
      "Tesla",
      "Rocket Lab",
      "Figure AI",
      "Boston Dynamics",
      "Agility Robotics",
      "1X Technologies",
      "NVIDIA",
      "Blue Origin",
      "NASA",
      "ULA"
    ],
    "discover_related_entities": true,
    "sources": [
      {
        "name": "space-race",
        "type": "rss",
        "url": "https://news.google.com/rss/search?q=%28SpaceX+OR+%22Rocket+Lab%22+OR+%22Blue+Origin%22%29+when%3A1d&hl=en-US&gl=US&ceid=US%3Aen",
        "language": "en",
        "source_class": "public_news_discovery"
      },
      {
        "name": "robotics",
        "type": "rss",
        "url": "https://news.google.com/rss/search?q=%28Tesla+Optimus+OR+%22Figure+AI%22+OR+humanoid+robotics%29+when%3A1d&hl=en-US&gl=US&ceid=US%3Aen",
        "language": "en",
        "source_class": "public_news_discovery"
      },
      {
        "name": "physical-ai",
        "type": "rss",
        "url": "https://news.google.com/rss/search?q=%22physical+AI%22+%28NVIDIA+OR+robotics+OR+research%29+when%3A1d&hl=en-US&gl=US&ceid=US%3Aen",
        "language": "en",
        "source_class": "public_news_discovery"
      }
    ]
  },
  "options": {
    "start_jitter_seconds": 300,
    "lookback_hours": 18,
    "max_items_per_run": 250,
    "summarize": [
      "news_and_company_developments",
      "technical_progress_and_evidence",
      "product_and_deployment_milestones",
      "competition_and_partnerships",
      "risks_and_open_questions"
    ],
    "output_artifact_types": [
      "timeline",
      "logic",
      "inferences",
      "relations",
      "summaries"
    ],
    "collection_stage": "news_discovery_only"
  },
  "schedule_format": "cron",
  "execution": {
    "command": [
      ".venv/bin/python",
      "-m",
      "collectors.news"
    ],
    "working_dir": ".",
    "timeout_seconds": 1800,
    "lock_group": "web-fetch"
  }
}
