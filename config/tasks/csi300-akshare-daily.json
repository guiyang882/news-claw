  "scheduler_engine": "news-claw",
  "task_type": "crawl",
  "enabled": false,
  "schedule": "30 6 * * 2-6",
  "schedule_format": "cron",
  "timezone": "Asia/Shanghai",
  "topic_ids": [],
  "collector": {
    "type": "akshare_daily",
    "provider": "eastmoney",
    "akshare_version": "1.19.1",
    "universe_path": "config/universes/csi300-akshare.json",
    "state_dir": "/mnt/quant-state/akshare-daily",
    "initial_start_date": "2026-10-01",
    "adjustment": "none",
    "access_review": {
      "status": "pending_provider_quota",
      "endpoint": "https://push2his.eastmoney.com/api/qt/stock/kline/get",
      "reviewed_at": "2026-10-15",
      "evidence_reference": "docs/AKSHARE_REVIEW_2026-10-15.md",
      "reason": "Exact push2his endpoint quota and automated access permission remain unconfirmed. EMT FAQ rates belong to a different API and cannot authorize this endpoint. Keep disabled under the user precondition."
    },
    "request_policy": {
      "min_interval_seconds": 60,
      "max_requests_per_run": 300,
      "max_requests_per_day": 300,
      "concurrency": 1,
      "automatic_retry": false,
      "policy_status": "local_upper_bounds_only_not_provider_confirmed",
