{
  "id": "stocks-quant-market-news-refresh",
  "name": "Tesla、SpaceX、Rocket Lab 新闻线索采集",
  "description": "Go 调度的小时级 Google News RSS 线索采集：Rocket Lab、SpaceX、Tesla；按用户要求恢复，每分钟最多一个请求，保留缓存与拒绝熔断。",
  "scheduler_engine": "news-claw",
  "enabled": true,
  "schedule": "5 * * * *",
  "timezone": "Asia/Shanghai",
  "schedule_format": "cron",
  "topic_ids": [
    "robotics-and-humanoids",
    "physical-ai",
    "space-race"
  ],
  "collector": {
    "type": "google_news_rss",
    "source_repo": "/mnt/quant/strategies/stocks-quant",
    "systemd_unit": "quant-news-refresh.timer",
    "execution_owner": "news-claw_via_legacy_service",
    "external_timer_active": false,
    "access_review": {
      "status": "enabled_user_override",
      "reviewed_at": "2026-10-11",
      "reason": "User explicitly requested restoring Google News RSS and overriding robots for this source.",
      "robots_url": "https://news.google.com/robots.txt",
      "terms_url": "https://policies.google.com/terms",
      "provider_use_restrictions": "Existing feed notices restrict use to a personal, noncommercial feed reader; user override is not provider permission.",
      "http_denial_and_rate_limit_circuits_retained": true
    },
    "observed_at": "2026-10-10",
    "query_entities": [
      "Rocket Lab",
      "SpaceX",
      "Tesla"
    ],
    "request_policy": {
      "max_requests_per_run": 3,
      "max_requests_per_minute": 1,
      "min_interval_seconds": 60,
      "cache_before_request": true,
      "single_process_lock": true,
      "stop_on_403_429_or_access_denial": true,
      "automatic_retry_after_denial": false,
      "shared_circuit_paths": [
        "/mnt/quant-state/quant-web/news_circuit.json"
      ]
    },
    "randomized_delay": "up to 4 minutes",
    "outputs": [
      "/mnt/quant-state/quant-web/news_timeline.json",
      "/mnt/quant-state/quant-web/news_collection_batches.jsonl"
    ],
    "migration_observed_at": "2026-10-10T08:44:00+00:00"
  },
  "options": {
    "migration_state": "go_scheduled_legacy_service",
    "start_jitter_seconds": 240
  },
  "legacy_schedule": {
    "schedule": "hourly",
    "format": "systemd_timer",
    "timer": "quant-news-refresh.timer"
  },
  "execution": {
    "command": [
      ".venv/bin/python",
      "-m",
      "collectors.legacy_service",
      "--unit",
      "quant-news-refresh.service"
    ],
    "working_dir": ".",
    "timeout_seconds": 480,
    "stop_grace_seconds": 115,
    "lock_group": "web-fetch",
    "adapter": "legacy_service",
    "systemd_unit": "quant-news-refresh.service",
    "recovery_command": [
      "systemctl",
      "stop",
      "quant-news-refresh.service"
    ],
    "recovery_timeout_seconds": 110
  },
  "task_type": "crawl",
  "workflow": {
    "website_repo": "/mnt/quant/strategies/stocks-quant",
    "website_runtime": {
      "stack": "nginx-nextjs-python",
      "proxy": "nginx",
      "frontend_service": "quant-next-web.service",
      "content_service": "quant-web.service",
      "proxy_service": "nginx.service",
      "content_update_action": "none",
      "content_reload_command": [
        "systemctl",
        "kill",
        "--kill-whom=main",
        "--signal=HUP",
        "quant-web.service"
      ],
      "frontend_restart_command": [
        "systemctl",
        "restart",
        "quant-next-web.service"
      ],
      "proxy_validate_command": [
        "/usr/sbin/nginx",
        "-t"
      ],
      "proxy_reload_command": [
        "systemctl",
        "reload",
        "nginx.service"
      ],
      "frontend_deployment": {
        "source_dir": "/mnt/quant/strategies/stocks-quant/web/frontend",
        "runbook": "/mnt/quant/strategies/stocks-quant/deployment/NEXTJS.md",
        "policy": "candidate_build_smoke_atomic_switch",
        "build_in_running_directory": false,
        "retain_previous_static_chunks": true,
        "steps": [
          "build_and_typecheck_in_separate_candidate_directory",
          "smoke_test_candidate",
          "retain_previous_static_chunks",
          "stop_frontend",
          "atomically_install_candidate_next_artifacts",
          "verify_service_user_file_permissions",
          "start_frontend",
          "verify_local_and_https_pages"
        ],
        "runtime_content_requires_frontend_build": false,
        "shared_credentials": "controlled_environment_only_not_task_json_or_logs",
        "candidate_build": {
          "working_dir": "<separate_candidate_repo_root>",
          "command": [
            "make",
            "test-frontend",
            "build-frontend"
          ]
        },
        "candidate_smoke": {
          "working_dir": "/mnt/quant/strategies/stocks-quant",
          "command": [
            "/mnt/quant/strategies/stocks-quant/web/.venv/bin/python",
            "web/frontend/scripts/smoke.py",
            "--frontend-dir",
            "<candidate_frontend_dir>"
          ]
        }
      },
      "health": {
        "host": "growthyoung.com",
        "content_port": 8000,
        "frontend_port": 3000,
        "https_port": 443,
        "content_path": "/healthz",
        "frontend_path": "/blog",
        "frontend_body_marker": "RESEARCH LIBRARY",
        "timeout_seconds": 10
      },
      "command_timeout_seconds": 30,
      "readiness_wait_seconds": 30
    },
    "outputs": [
      "/mnt/quant-state/quant-web/news_timeline.json",
      "/mnt/quant-state/quant-web/news_collection_batches.jsonl"
    ],
    "website_delivery": {
      "kind": "validated_runtime_snapshot",
      "reader": "Next.js via authenticated local Python content bridge",
      "after_publish": "none",
      "frontend_build_required": false,
      "restart_required": false
    }
  }
}
