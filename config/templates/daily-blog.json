{
  "id": "example-daily-blog-workflow",
  "name": "每周两期研究博客：周五大事件与周日周末观察",
  "description": "北京时间周五、周日19:30写作，21:30仅补启动尚未进入模型的当期；周五聚焦本周大事件，周日聚焦周末有价值的新内容。保留双语、证据审核与8–12分钟短文选项，每期最多一篇。",
  "scheduler_engine": "news-claw",
  "task_type": "workflow",
  "enabled": false,
  "schedule": "30 19,21 * * 0,5",
  "timezone": "Asia/Shanghai",
  "schedule_format": "cron",
  "topic_ids": [
    "us-china-export-controls",
    "ai-products-attention-feedback",
    "robotics-and-humanoids",
    "physical-ai",
    "space-race",
    "daily-research-blog"
  ],
  "options": {
    "start_jitter_seconds": 420,
    "model_permissions": "full_no_interactive_approval"
  },
  "execution": {
    "command": [
      "/mnt/quant/strategies/stocks-quant/web/.venv/bin/python",
      "-m",
      "workflows.daily_blog"
    ],
    "working_dir": ".",
    "timeout_seconds": 4500,
    "stop_grace_seconds": 15,
    "lock_group": "model-cli",
    "env": {
      "PYTHONDONTWRITEBYTECODE": "1",
      "HOME": "/root",
      "CODEX_HOME": "/root/.codex"
    }
  },
  "workflow": {
    "website_repo": "/mnt/quant/strategies/stocks-quant",
    "website_state": "/mnt/quant-state/quant-web/blog",
    "public_base_url": "https://growthyoung.com",
    "writer": {
      "executable": "/root/.local/bin/agy",
      "model": "gemini-3.8-flash-high",
      "timeout_seconds": 1200,
      "permissions": "full"
    },
    "reviewer": {
      "executable": "/usr/local/bin/codex",
      "model": "gpt-6.1-sol",
      "timeout_seconds": 300,
      "permissions": "full",
      "service_tier": "fast",
      "reasoning_effort": null
    },
    "humanizer_skill": "/root/.codex/skills/humanizer/SKILL.md",
    "min_model_interval_seconds": 10,
    "inputs": {
      "lookback_days": 2,
      "max_documents": 30,
      "max_text_chars": 4000,
      "max_legacy_headlines": 18,
      "max_snapshot_age_days": 14,
      "company_pulses": "/mnt/quant-state/quant-web/company_pulses.json",
      "news_timeline": "/mnt/quant-state/quant-web/news_timeline.json",
      "max_reviewed_topic_summaries": 5,
      "reviewed_topic_lookback_days": 2,
      "max_primary_pages": 14,
      "primary_max_text_chars": 12000
    },
    "stages": [
      "codex_topics_and_outline",
      "agy_draft",
      "codex_length_repair_if_needed",
      "codex_fact_review",
      "codex_correction_if_rejected",
      "codex_re_review_if_corrected",
      "codex_humanizer",
      "codex_final_review",
      "codex_final_correction_if_rejected",
      "codex_final_re_review_if_corrected",
      "offline_publish"
    ],
    "publication_policy": "Publish only on Friday and Sunday in Asia/Shanghai from 2026-10-27. Readiness before model reservation; 21:30 only starts an edition that has not entered a model stage. One article per edition date, with bounded same-day watchdog recovery. Off-days are successful no-ops, never missing daily publications. Preserve source dates, bilingual independent review, per-day model caps and provider circuits.",
    "network_policy": {
      "source_web_requests": 0,
      "max_cli_invocations_per_day": 10,
      "automatic_retries": 0,
      "provider_denial": "persistent_circuit_requires_explicit_reset"
    },
    "outputs": [
      "data/runs/<run_id>/source-packet.json",
      "data/runs/<run_id>/topic-candidates.json",
      "data/runs/<run_id>/blog-outline.json",
      "data/runs/<run_id>/blog-outline.md",
      "data/runs/<run_id>/final-draft.json",
      "/mnt/quant-state/quant-web/blog/automation-reviews/<slug>.json",
      "/mnt/quant-state/quant-web/blog/manifest.json"
    ],
    "max_draft_revisions": 1,
    "planner": {
      "executable": "/usr/local/bin/codex",
      "model": "gpt-6.1-sol",
      "timeout_seconds": 300,
      "permissions": "full",
      "service_tier": "fast",
      "reasoning_effort": null
    },
    "planning": {
      "max_candidates": 3,
      "min_sections": 6,
      "max_sections": 9,
      "selection_policy": "Use packet.edition dates and focus. Friday: significant events from Monday to Friday. Sunday: prioritize weekend developments; if sparse, select an unused substantive topic from the same week with explicit original dates, without repeating Friday or calling old material weekend news. Cite at least one complete primary body from source_window_start through window_end; older sources are background. Evidence depth and reader value determine long article or supported brief."
    },
    "reading": {
      "target_minutes": 20,
      "tolerance_minutes": 3,
      "zh_units_per_minute": 300,
      "en_words_per_minute": 200,
      "formats": [
        {
          "target_minutes": 20,
          "tolerance_minutes": 3
        },
        {
          "target_minutes": 10,
          "tolerance_minutes": 2
        }
      ]
    },
    "stage_timeout_seconds": {
      "revise": 900,
      "humanize": 900,
      "repair_length": 900,
      "revise_final": 900
    },
    "editorial_skill": "/root/.codex/skills/research-blog-editor/SKILL.md",
    "max_length_repairs": 1,
    "max_final_revisions": 1,
    "presentation": {
      "slug_style": "topic-date",
      "max_topic_words": 8,
      "media_catalog": "config/media/approved-assets.json",
      "preferred_tables": 2,
      "preferred_diagrams": 2,
      "emphasis": "restrained_bold_italic_underline",
      "public_process_notes": false,
      "references": "source_based_appendix"
    },
    "website_runtime": {
      "stack": "nginx-nextjs-python",
      "proxy": "nginx",
      "frontend_service": "quant-next-web.service",
      "content_service": "quant-web.service",
      "proxy_service": "nginx.service",
      "content_update_action": "none",
      "content_reload_command": [
        "systemctl",
        "kill",
        "--kill-whom=main",
        "--signal=HUP",
        "quant-web.service"
      ],
      "frontend_restart_command": [
        "systemctl",
        "restart",
        "quant-next-web.service"
      ],
      "proxy_validate_command": [
        "/usr/sbin/nginx",
        "-t"
      ],
      "proxy_reload_command": [
        "systemctl",
        "reload",
        "nginx.service"
      ],
      "frontend_deployment": {
        "source_dir": "/mnt/quant/strategies/stocks-quant/web/frontend",
        "runbook": "/mnt/quant/strategies/stocks-quant/deployment/NEXTJS.md",
        "policy": "candidate_build_smoke_atomic_switch",
        "build_in_running_directory": false,
        "retain_previous_static_chunks": true,
        "steps": [
          "build_and_typecheck_in_separate_candidate_directory",
          "smoke_test_candidate",
          "retain_previous_static_chunks",
          "stop_frontend",
          "atomically_install_candidate_next_artifacts",
          "verify_service_user_file_permissions",
          "start_frontend",
          "verify_local_and_https_pages"
        ],
        "runtime_content_requires_frontend_build": false,
        "shared_credentials": "controlled_environment_only_not_task_json_or_logs",
        "candidate_build": {
          "working_dir": "<separate_candidate_repo_root>",
          "command": [
            "make",
            "test-frontend",
            "build-frontend"
          ]
        },
        "candidate_smoke": {
          "working_dir": "/mnt/quant/strategies/stocks-quant",
          "command": [
            "/mnt/quant/strategies/stocks-quant/web/.venv/bin/python",
            "web/frontend/scripts/smoke.py",
            "--frontend-dir",
            "<candidate_frontend_dir>"
          ]
        }
      },
      "health": {
        "host": "growthyoung.com",
        "content_port": 8000,
        "frontend_port": 3000,
        "https_port": 443,
        "content_path": "/healthz",
        "frontend_path": "/blog",
        "frontend_body_marker": "RESEARCH LIBRARY",
        "timeout_seconds": 10
      },
      "command_timeout_seconds": 30,
      "readiness_wait_seconds": 30
    },
    "website_delivery": {
      "kind": "validated_blog_runtime",
      "reader": "Next.js via authenticated local Python content bridge",
      "after_publish": "none",
      "frontend_build_required": false,
      "restart_required": false
    },
    "readiness": {
      "enabled": true,
      "upstream_task_id": "daily-blog-primary-evidence",
      "min_complete_sources": 2,
      "min_unused_sources": 1,
      "min_body_chars": 1000,
      "max_source_age_days": 14,
      "recent_publication_days": 7
    },
    "publication_calendar": {
      "effective_from": "2026-10-27",
      "editions": [
        {
          "id": "friday-week-review",
          "weekday": 5,
          "window_start_weekday": 1,
          "focus": "本周大事件：从周一至周五的重大变化中选择最有证据和读者价值的核心问题，解释影响、机制、反证条件与后续观察点。"
        },
        {
          "id": "sunday-weekend-notes",
          "weekday": 7,
          "window_start_weekday": 6,
          "source_window_start_weekday": 1,
          "focus": "周末观察：优先周六至周日有价值的新内容或进展；若周末新材料不足，可从本周尚未展开的材料做周末专题，明确来源日期与读者价值，不冒充周末新事件，避免重复周五主题和结论。"
        }
      ]
    }
  }
}
